    wch_lines("${WCH_PROJECT}/.template" _template_lines)
    foreach(_line IN LISTS _template_lines)
        if(_line MATCHES "^([^=]+)=(.*)$")
            string(STRIP "${CMAKE_MATCH_1}" _key)
            string(STRIP "${CMAKE_MATCH_2}" _value)
            if(_key STREQUAL "Mcu Type")
                set(WCH_DEVICE_FAMILY "${_value}")
            elseif(_key STREQUAL "MCU")
                set(WCH_DEVICE "${_value}")
            elseif(_key STREQUAL "Link")
                set(WCH_DEBUG_LINK "${_value}")
            elseif(_key STREQUAL "Address")
                if(NOT _value STREQUAL "" AND NOT _value STREQUAL "0x08000000")
                    set(WCH_FLASH_ADDRESS "${_value}")
                endif()
            endif()
        endif()
    endforeach()
endif()

set(WCH_GDB_PORT 3333)
set(WCH_SVD_PATH "")
