        string(STRIP "${_line}" _line)
        if(_line MATCHES "^LIBS[ \t]*:=[ \t]*(.*)$")
            separate_arguments(_libraries UNIX_COMMAND "${CMAKE_MATCH_1}")
            foreach(_library IN LISTS _libraries)
                string(REGEX REPLACE "^-l" "" _library "${_library}")
                list(APPEND WCH_LIBRARIES "${_library}")
