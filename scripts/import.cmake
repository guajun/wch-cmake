macro(wch_parse_project_metadata)
set(WCH_ARTIFACT_NAME "")
set(WCH_LINK_FLAGS)
set(WCH_LINKER_SCRIPT "")
set(_link_tool "")
foreach(_line IN LISTS _make_lines)
    string(FIND "${_line}" "$(OBJS)" _has_objects)
    string(FIND "${_line}" " -o " _has_output)
    string(TOLOWER "${_line}" _line_lower)
    string(FIND "${_line_lower}" ".elf" _has_elf)
    if(_has_objects EQUAL -1 OR _has_output EQUAL -1 OR _has_elf EQUAL -1)
        continue()
    endif()
    wch_parse_command("${_line}" _arguments)
    list(LENGTH _arguments _argument_count)
    if(_argument_count LESS 3)
        continue()
    endif()
    list(GET _arguments 0 _link_tool)
    set(_skip_next OFF)
    math(EXPR _last_argument "${_argument_count} - 1")
    foreach(_index RANGE 1 ${_last_argument})
        if(_skip_next)
            set(_skip_next OFF)
            continue()
        endif()
        list(GET _arguments ${_index} _argument)
        if(_argument STREQUAL "-o")
            math(EXPR _value_index "${_index} + 1")
            list(GET _arguments ${_value_index} _output)
            get_filename_component(WCH_ARTIFACT_NAME "${_output}" NAME)
            set(_skip_next ON)
        elseif(_argument STREQUAL "-T")
            math(EXPR _value_index "${_index} + 1")
            list(GET _arguments ${_value_index} _linker_script)
            wch_project_path("${_linker_script}" "${WCH_PROJECT}" WCH_LINKER_SCRIPT)
            set(_skip_next ON)
        elseif(_argument MATCHES "^-T(.+)$")
            wch_project_path("${CMAKE_MATCH_1}" "${WCH_PROJECT}" WCH_LINKER_SCRIPT)
        elseif(_argument MATCHES "\\$\\((OBJS|LIBS|USER_OBJS)")
            continue()
        elseif(_argument MATCHES "^-Wl,-Map")
            continue()
        else()
            list(APPEND WCH_LINK_FLAGS "${_argument}")
        endif()
    endforeach()
    break()
endforeach()
if(WCH_ARTIFACT_NAME STREQUAL "" OR WCH_LINKER_SCRIPT STREQUAL "")
    message(FATAL_ERROR "Could not parse the MRS2 ELF link command")
endif()

get_filename_component(_link_tool_name "${_link_tool}" NAME)
