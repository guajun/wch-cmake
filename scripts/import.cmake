    if(_launch_content MATCHES "key=\"com\\.mounriver\\.debug\\.gdbjtag\\.svdPath\"[ \t\r\n]+value=\"([^\"]*)\"")
        set(WCH_SVD_PATH "${CMAKE_MATCH_1}")
    endif()
    if(_launch_content MATCHES "gdbServerOther\"[ \t\r\n]+value=\"[^\"]*[/\\]([^/\\&]+\\.cfg)")
        set(WCH_OPENOCD_CONFIG "${CMAKE_MATCH_1}")
