function(wch_lines path output)
    file(READ "${path}" _content)
    string(REPLACE "\r\n" "\n" _content "${_content}")
    string(REPLACE "\r" "\n" _content "${_content}")
    # Slash normalization also prevents Make's line-continuation backslash from
    # escaping the CMake list separator used below.
    string(REPLACE "\\" "/" _content "${_content}")
    string(REPLACE ";" "\\;" _content "${_content}")
    string(REPLACE "\n" ";" _lines "${_content}")
    set(${output} "${_lines}" PARENT_SCOPE)
endfunction()

function(wch_unquote input output)
    string(STRIP "${input}" _value)
    if(_value MATCHES "^\"(.*)\"$")
        set(_value "${CMAKE_MATCH_1}")
    endif()
    set(${output} "${_value}" PARENT_SCOPE)
endfunction()

function(wch_project_path input base output)
    wch_unquote("${input}" _value)
    file(TO_CMAKE_PATH "${_value}" _value)
    if(IS_ABSOLUTE "${_value}")
        get_filename_component(_absolute "${_value}" ABSOLUTE)
    else()
        get_filename_component(_absolute "${base}/${_value}" ABSOLUTE)
    endif()
    file(TO_CMAKE_PATH "${_absolute}" _absolute)
    file(RELATIVE_PATH _relative "${WCH_PROJECT}" "${_absolute}")
    if(_relative STREQUAL ".." OR _relative MATCHES "^[.][.]/")
        set(${output} "${_absolute}" PARENT_SCOPE)
    else()
        set(${output} "${_relative}" PARENT_SCOPE)
    endif()
endfunction()

macro(wch_append_unique variable value)
    if(NOT "${value}" STREQUAL "")
        list(FIND ${variable} "${value}" _wch_found)
        if(_wch_found EQUAL -1)
            list(APPEND ${variable} "${value}")
        endif()
    endif()
endmacro()

function(wch_parse_command command output)
    string(STRIP "${command}" _command)
    string(REGEX REPLACE "^@[ \t]*" "" _command "${_command}")
    separate_arguments(_arguments UNIX_COMMAND "${_command}")
    set(${output} "${_arguments}" PARENT_SCOPE)
endfunction()

