if(WCH_TOOL_PREFIX STREQUAL "riscv-wch-elf-")
    set(WCH_TOOLCHAIN_NAME "RISC-V Embedded GCC12")
elseif(WCH_TOOL_PREFIX STREQUAL "riscv32-wch-elf-")
    set(WCH_TOOLCHAIN_NAME "RISC-V Embedded GCC15")
else()
    set(WCH_TOOLCHAIN_NAME "RISC-V Embedded GCC")
endif()
endmacro()
if(NOT _subdir_files)
    message(FATAL_ERROR "MRS2 makefile contains no included subdir.mk files")
endif()

set(WCH_SOURCES)
set(WCH_C_FLAGS)
set(WCH_CXX_FLAGS)
set(WCH_ASM_FLAGS)
set(WCH_INCLUDE_DIRS)
set(WCH_ASM_INCLUDE_DIRS)
set(_c_recipe_seen OFF)
set(_cxx_recipe_seen OFF)
set(_asm_recipe_seen OFF)

foreach(_subdir IN LISTS _subdir_files)
    if(NOT EXISTS "${_subdir}")
        message(FATAL_ERROR "Included MRS2 make fragment not found: ${_subdir}")
    endif()
    wch_lines("${_subdir}" _subdir_lines)
    set(_source_block "")
    foreach(_line IN LISTS _subdir_lines)
        string(STRIP "${_line}" _trimmed)
        if(_source_block STREQUAL "")
            if(_trimmed MATCHES "^(C_SRCS|CPP_SRCS|CXX_SRCS|S_SRCS|S_UPPER_SRCS|ASM_SRCS|ASM_UPPER_SRCS)[ \t]*[+]=[ \t]*(.*)$")
                set(_source_block "${CMAKE_MATCH_1}")
                set(_source_value "${CMAKE_MATCH_2}")
            else()
                set(_source_value "")
            endif()
        else()
            set(_source_value "${_trimmed}")
        endif()

        if(NOT _source_block STREQUAL "")
            set(_continues OFF)
            if(_source_value MATCHES "/[ \t]*$")
                set(_continues ON)
            endif()
            string(REGEX REPLACE "[ \t]*/[ \t]*$" "" _source_value "${_source_value}")
            string(STRIP "${_source_value}" _source_value)
            if(NOT _source_value STREQUAL "")
                separate_arguments(_source_values UNIX_COMMAND "${_source_value}")
                foreach(_source IN LISTS _source_values)
                    wch_project_path("${_source}" "${WCH_BUILD_DIR_ABS}" _source_relative)
                    list(APPEND WCH_SOURCES "${_source_relative}")
                endforeach()
            endif()
            if(NOT _continues)
                set(_source_block "")
            endif()
        endif()

        string(FIND "${_line}" "-c -o \"$@\" \"$<\"" _compile_position)
        if(_compile_position EQUAL -1)
            continue()
        endif()
        wch_parse_command("${_line}" _arguments)
        list(LENGTH _arguments _argument_count)
        if(_argument_count LESS 2)
            continue()
        endif()
        list(GET _arguments 0 _compiler)
        string(TOLOWER "${_compiler}" _compiler_lower)
        list(FIND _arguments "assembler-with-cpp" _assembler_index)
        if(NOT _assembler_index EQUAL -1)
            set(_language "asm")
        elseif(_compiler_lower MATCHES "g[+][+]([.]exe)?$")
            set(_language "cxx")
        else()
            set(_language "c")
        endif()

        set(_recipe_flags)
        set(_recipe_includes)
        set(_skip_next OFF)
        math(EXPR _last_argument "${_argument_count} - 1")
        foreach(_index RANGE 1 ${_last_argument})
            if(_skip_next)
                set(_skip_next OFF)
                continue()
            endif()
            list(GET _arguments ${_index} _argument)
            if(_argument STREQUAL "-I" OR _argument STREQUAL "-isystem")
                math(EXPR _include_index "${_index} + 1")
                if(_include_index LESS _argument_count)
                    list(GET _arguments ${_include_index} _include)
                    wch_project_path("${_include}" "${WCH_PROJECT}" _include)
                    wch_append_unique(_recipe_includes "${_include}")
                    set(_skip_next ON)
                endif()
            elseif(_argument MATCHES "^-I(.+)$")
                wch_project_path("${CMAKE_MATCH_1}" "${WCH_PROJECT}" _include)
                wch_append_unique(_recipe_includes "${_include}")
            elseif(_argument STREQUAL "-MMD" OR _argument STREQUAL "-MP" OR
                   _argument STREQUAL "-c" OR _argument STREQUAL "$@" OR
                   _argument STREQUAL "$<")
                continue()
            elseif(_argument MATCHES "^-MF" OR _argument MATCHES "^-MT")
                continue()
            elseif(_argument STREQUAL "-o")
                set(_skip_next ON)
            else()
                list(APPEND _recipe_flags "${_argument}")
            endif()
        endforeach()

        if(_language STREQUAL "c")
            if(_c_recipe_seen AND (NOT "${WCH_C_FLAGS}" STREQUAL "${_recipe_flags}" OR
                                  NOT "${WCH_INCLUDE_DIRS}" STREQUAL "${_recipe_includes}"))
                message(FATAL_ERROR "MRS2 uses different C flags between source directories")
            endif()
            set(WCH_C_FLAGS "${_recipe_flags}")
            set(WCH_INCLUDE_DIRS "${_recipe_includes}")
            set(_c_recipe_seen ON)
        elseif(_language STREQUAL "cxx")
            if(_cxx_recipe_seen AND NOT "${WCH_CXX_FLAGS}" STREQUAL "${_recipe_flags}")
                message(FATAL_ERROR "MRS2 uses different C++ flags between source directories")
            endif()
            set(WCH_CXX_FLAGS "${_recipe_flags}")
            foreach(_include IN LISTS _recipe_includes)
                wch_append_unique(WCH_INCLUDE_DIRS "${_include}")
            endforeach()
            set(_cxx_recipe_seen ON)
        else()
            if(_asm_recipe_seen AND (NOT "${WCH_ASM_FLAGS}" STREQUAL "${_recipe_flags}" OR
                                    NOT "${WCH_ASM_INCLUDE_DIRS}" STREQUAL "${_recipe_includes}"))
                message(FATAL_ERROR "MRS2 uses different assembler flags between source directories")
            endif()
            set(WCH_ASM_FLAGS "${_recipe_flags}")
            set(WCH_ASM_INCLUDE_DIRS "${_recipe_includes}")
            set(_asm_recipe_seen ON)
        endif()
    endforeach()
endforeach()

wch_parse_project_metadata()
wch_install_project()
