function(wch_install_project)
# Install only after all MRS2 metadata and source recipes have been parsed.
set(_template_root "${CMAKE_CURRENT_LIST_DIR}/../templates")
function(wch_generated_content destination content)
    set(_write ON)
    if(EXISTS "${destination}")
        file(READ "${destination}" _existing)
        if(_existing STREQUAL "${content}")
            set(_write OFF)
        elseif(destination MATCHES "CMakeUserPresets\\.json$" AND NOT WCH_FORCE)
            set(_write OFF)
            message(STATUS "Keeping existing CMakeUserPresets.json")
        elseif(NOT WCH_FORCE AND NOT _existing MATCHES "Generated by wch-cmake" AND
               NOT _existing MATCHES "\"wch-cmake\"" AND
               NOT _existing MATCHES "\"WCH: configure release\"")
            message(FATAL_ERROR "Refusing to replace user-owned file: ${destination}; use --force")
        endif()
    endif()
    if(_write)
        get_filename_component(_directory "${destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${_directory}")
        file(WRITE "${destination}" "${content}")
    endif()
endfunction()

function(wch_install_template source destination)
    file(READ "${_template_root}/${source}" _content)
    set(TOOLCHAIN_NAME "${WCH_TOOLCHAIN_NAME}")
    string(CONFIGURE "${_content}" _content @ONLY)
    wch_generated_content("${WCH_PROJECT}/${destination}" "${_content}")
endfunction()

foreach(_mapping IN ITEMS
        "CMakeLists.txt|CMakeLists.txt"
        "CMakePresets.json|CMakePresets.json"
        "wch-toolchain.cmake|cmake/wch-toolchain.cmake"
        "wch-firmware.cmake|cmake/wch-firmware.cmake"
        "wch-objdump.cmake|cmake/wch-objdump.cmake"
        "wch-cxx-runtime.c|cmake/wch-cxx-runtime.c"
        "activate.ps1|scripts/activate.ps1"
        "activate.cmd|scripts/activate.cmd"
        "activate.sh|scripts/activate.sh"
        "tasks.json|.vscode/tasks.json")
    string(REPLACE "|" ";" _mapping "${_mapping}")
    list(GET _mapping 0 _source)
    list(GET _mapping 1 _destination)
    wch_install_template("${_source}" "${_destination}")
endforeach()

function(wch_escape value output)
    string(REPLACE "\\" "/" _value "${value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    string(REPLACE ";" "\\;" _value "${_value}")
    string(REPLACE "$" "\\$" _value "${_value}")
    set(${output} "${_value}" PARENT_SCOPE)
endfunction()

set(_manifest "# Generated by wch-cmake from MRS2 generated makefiles.\n# This is the build source of truth after import; re-import replaces it.\n")
macro(wch_manifest_scalar name)
    wch_escape("${${name}}" _escaped)
    string(APPEND _manifest "set(${name} \"${_escaped}\")\n")
endmacro()
macro(wch_manifest_list name)
    string(APPEND _manifest "set(${name}\n")
    foreach(_value IN ITEMS ${ARGN})
        wch_escape("${_value}" _escaped)
        string(APPEND _manifest "    \"${_escaped}\"\n")
    endforeach()
    string(APPEND _manifest ")\n")
endmacro()

